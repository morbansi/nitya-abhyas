<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_nitya_logo"
            android:contentDescription="@null" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nitya"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:paddingStart="6dp" />
    </LinearLayout>

    <!-- Row 0 -->
    <LinearLayout android:id="@+id/row0"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingVertical="4dp">
        <TextView android:id="@+id/emoji0" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="16sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp">
            <TextView android:id="@+id/label0" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="#FFFFFF"
                android:textSize="13sp" android:maxLines="1" />
            <TextView android:id="@+id/streak0" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="#99FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
        <ImageButton android:id="@+id/check0" android:layout_width="32dp"
            android:layout_height="32dp" android:background="@android:color/transparent"
            android:scaleType="fitCenter" android:src="@drawable/ic_check_empty" />
    </LinearLayout>

    <!-- Row 1 -->
    <LinearLayout android:id="@+id/row1"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingVertical="4dp">
        <TextView android:id="@+id/emoji1" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="16sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp">
            <TextView android:id="@+id/label1" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="#FFFFFF"
                android:textSize="13sp" android:maxLines="1" />
            <TextView android:id="@+id/streak1" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="#99FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
        <ImageButton android:id="@+id/check1" android:layout_width="32dp"
            android:layout_height="32dp" android:background="@android:color/transparent"
            android:scaleType="fitCenter" android:src="@drawable/ic_check_empty" />
    </LinearLayout>

    <!-- Row 2 -->
    <LinearLayout android:id="@+id/row2"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingVertical="4dp">
        <TextView android:id="@+id/emoji2" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="16sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp">
            <TextView android:id="@+id/label2" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="#FFFFFF"
                android:textSize="13sp" android:maxLines="1" />
            <TextView android:id="@+id/streak2" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="#99FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
        <ImageButton android:id="@+id/check2" android:layout_width="32dp"
            android:layout_height="32dp" android:background="@android:color/transparent"
            android:scaleType="fitCenter" android:src="@drawable/ic_check_empty" />
    </LinearLayout>

</LinearLayout>
